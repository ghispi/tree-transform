#!/usr/bin/env php
<?php

declare(strict_types=1);

// Prepares docs/*.md for the documentation site in var/docs-site/docs (links outside docs/ become GitHub URLs).
// Run inside Docker: make docs-site. DOCS_REF picks the git ref those links point to (default: main).

use Ghispi\TreeTransform\Tests\Docs\Support\DocsSite;

require __DIR__ . '/../vendor/autoload.php';

$root = dirname(__DIR__);
$ref = getenv('DOCS_REF') ?: 'main';
$site = new DocsSite($root);

$broken = array_filter($site->outsideLinks(), static fn(array $link): bool => !$link['exists']);
foreach ($broken as $link) {
    fwrite(STDERR, "Broken link in docs/{$link['page']}: ../{$link['target']}\n");
}
if ($broken !== []) {
    exit(1);
}

$site->write($root . '/var/docs-site/docs', $ref);
echo "Prepared var/docs-site/docs (links to {$ref}).\n";
