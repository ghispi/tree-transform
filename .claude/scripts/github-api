#!/bin/sh
# Calls the GitHub REST API for ghispi/tree-transform with the repository token, taken from the repo-local git
# credential helper. The token is passed to curl in a header and never printed.
#
#   .claude/scripts/github-api GET  pulls/12
#   .claude/scripts/github-api POST pulls '{"title":"…","head":"branch","base":"main","body":"…"}'
#   .claude/scripts/github-api PUT  pulls/12/merge '{"merge_method":"squash"}'
#
# The path is relative to https://api.github.com/repos/ghispi/tree-transform/. Only for pull requests: the
# token has Contents and Pull requests permissions, nothing else.
set -eu

method=$1
path=$2
data=${3-}

token=$(printf 'protocol=https\nhost=github.com\n\n' | git credential fill | sed -n 's/^password=//p')
[ -n "$token" ] || { echo "github-api: no token from the git credential helper" >&2; exit 1; }

set -- -sS -X "$method" \
    -H "Accept: application/vnd.github+json" \
    -H "X-GitHub-Api-Version: 2022-11-28" \
    "https://api.github.com/repos/ghispi/tree-transform/$path"
[ -z "$data" ] || set -- "$@" -d "$data"

printf 'header = "Authorization: Bearer %s"\n' "$token" | curl --config - "$@"
