{
    "name": "ghispi/tree-transform",
    "description": "Efficient, streaming filtering and transformation of trees (nested set, adjacency list, materialized path, nested arrays) with pluggable strategies. Works with Gedmo Doctrine tree behaviours.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "tree",
        "nested set",
        "adjacency list",
        "materialized path",
        "doctrine",
        "gedmo",
        "filter"
    ],
    "homepage": "https://github.com/ghispi/tree-transform",
    "support": {
        "issues": "https://github.com/ghispi/tree-transform/issues",
        "source": "https://github.com/ghispi/tree-transform"
    },
    "authors": [
        {
            "name": "ghispi",
            "homepage": "https://github.com/ghispi"
        }
    ],
    "require": {
        "php": ">=8.4"
    },
    "require-dev": {
        "doctrine/orm": "^3.6",
        "friendsofphp/php-cs-fixer": "^3.85",
        "gedmo/doctrine-extensions": "^3.20",
        "infection/infection": "^0.29.14",
        "phpbench/phpbench": "^1.3",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-strict-rules": "^2.0.4",
        "phpunit/phpunit": "^12.2",
        "sanmai/pipeline": "^6.20",
        "symfony/cache": "^7.2"
    },
    "suggest": {
        "doctrine/orm": "^3.6, to load trees from the database with the Gedmo bridge",
        "gedmo/doctrine-extensions": "^3.20, for the Gedmo tree bridge (Bridge\\Gedmo\\GedmoTree)"
    },
    "conflict": {
        "doctrine/orm": "<3.6",
        "gedmo/doctrine-extensions": "<3.20"
    },
    "autoload": {
        "psr-4": {
            "Ghispi\\TreeTransform\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ghispi\\TreeTransform\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "minimum-stability": "stable"
}
