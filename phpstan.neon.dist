includes:
    - vendor/phpstan/phpstan-strict-rules/rules.neon

parameters:
    level: max
    paths:
        - src
        - tests
    ignoreErrors:
        # Accessors exist to read fields by name from arbitrary payloads.
        -
            identifiers:
                - property.dynamicName
                - method.dynamicName
                - property.nonObject
                - method.nonObject
                - offsetAccess.nonOffsetAccessible
            path: src/Accessor/*
            reportUnmatched: false
        # Test entities are written by Doctrine/Gedmo, not by our code.
        -
            identifiers:
                - property.onlyWritten
                - property.unusedType
            path: tests/Integration/Entity/*
